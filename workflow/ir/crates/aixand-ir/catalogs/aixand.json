              "recipient": {
                "kind": "string"
              },
              "content": {
                "kind": "string"
              },
              "created_at": {
                "kind": "string"
              },
              "idempotency_key": {
                "kind": "string",
                "nullable": true
              },
              "reply_to": {
                "kind": "integer",
