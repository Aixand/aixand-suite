              "recipient",
              "content",
              "created_at",
              "idempotency_key",
              "reply_to",
              "acknowledged_at"
            ]
          }
        }
      },
      "description": "Wait for a pending reply correlated to a message sent by this mailbox identity. Optional sender must match the returned authenticated sender. Does not acknowledge. Timeout raises a failure; failure leaves messages pending. Managed consumer failure interrupts waiting. Failures stop execution, are never retried, and cancellation does not roll back effects."
    },
    {
      "id": "carrier.mailbox.wait",
      "version": "1.0.0",
      "inputs": {
        "mailbox": {
          "type": {
            "kind": "opaque",
