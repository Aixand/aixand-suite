          "type": {
            "kind": "string"
          }
        },
        "address": {
          "type": {
            "kind": "string",
            "nullable": true
          }
        }
      },
      "description": "Attach a run in the configured manager environment. Reuses the shared handle in this scope. Does not recreate a Carrier consumer or confer resource ownership. Failures stop execution, are never retried, and cancellation does not roll back effects."
    },
    {
      "id": "aixand.agent.send",
      "version": "1.0.0",
      "inputs": {
        "agent": {
          "type": {
            "kind": "opaque",
            "id": "aixand.agent",
            "version": "1"
