    {
      "id": "aixand.agents.spawn",
      "version": "1.0.0",
      "inputs": {
        "provider": {
          "type": {
            "kind": "string"
          },
          "required": false,
          "default": "codex"
        },
        "profile": {
          "type": {
            "kind": "string"
          },
          "required": false,
          "default": "default"
        },
        "cwd": {
          "type": {
            "kind": "string",
            "nullable": true
          },
          "required": false
        },
        "address": {
          "type": {
            "kind": "string",
            "nullable": true
          },
          "required": false
        },
        "instructions": {
          "type": {
            "kind": "string",
            "nullable": true
          },
          "required": false
        },
        "timeout": {
          "type": {
            "kind": "number",
            "nullable": true
          },
          "required": false,
          "description": "Seconds. Omission or null uses the connection's configured timeout."
        }
      },
      "outputs": {
        "agent": {
          "type": {
            "kind": "opaque",
            "id": "aixand.agent",
            "version": "1"
          }
        },
        "run_id": {
          "type": {
            "kind": "string"
          }
        },
        "address": {
          "type": {
            "kind": "string",
            "nullable": true
          }
        }
      },
      "description": "Launch an owned agent; completion establishes a composition handle, not task completion. Address optionally sets up a managed Carrier inbox; null or omission leaves it absent. cwd/instructions null or omission use SDK defaults. Setup failures retain launch identity and uncertain-effect details. Cleanup detaches unless stop-owned is configured. Failures stop execution, are never retried, and cancellation does not roll back effects."
    },
