        "snapshots": {
          "type": {
            "kind": "array",
            "items": {
              "kind": "object",
              "properties": {
                "id": {
                  "kind": "integer"
                },
                "sender": {
                  "kind": "string"
                },
                "recipient": {
                  "kind": "string"
                },
                "content": {
                  "kind": "string"
                },
                "created_at": {
                  "kind": "string"
                },
                "idempotency_key": {
                  "kind": "string",
                  "nullable": true
                },
                "reply_to": {
                  "kind": "integer",
                  "nullable": true
                },
                "acknowledged_at": {
                  "kind": "string",
                  "nullable": true
