HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5186,http://localhost:5173,http://127.0.0.1:5186,http://127.0.0.1:5173

# First startup prepares password setup automatically. Create your password in the local browser.
# Default: ~/.aixand/suite/auth/auth.db. Preserve it and its .initialized marker.
# AIXAND_AUTH_DATABASE=/absolute/path/to/private/auth.db
# Plain HTTP is allowed only for loopback development. Disable this for deployment.
AIXAND_AUTH_DEV_HTTP=1
# For HTTPS termination, trust only the actual reverse proxy peer addresses.
# AIXAND_TRUST_PROXY=127.0.0.1,::1

# Optional; defaults to ~/.aixand/undercurrent. Use an absolute path.
# UNDERCURRENT_HOME=/absolute/path/to/undercurrent
# TERMINAL_BRIDGE_PATH=/absolute/path/to/aixand-terminal-bridge
# TERMINAL_SHELL=/bin/bash
# TERMINAL_CWD=/absolute/path/to/workspace

# Workflows: defaults to built-in Aixand and verifier catalogs.
# WORKFLOW_BRIDGE_PATH=/absolute/path/to/aixand-workflow-bridge
# WORKFLOW_CWD=/absolute/path/to/aixand-ir
# WORKFLOW_CATALOG_PATHS=/absolute/catalog-one.json:/absolute/catalog-two.json
# Agent operations use the existing SDK/Agent Manager profile configuration.
# Relative paths inside SDK config resolve from WORKFLOW_CWD.
# WORKFLOW_SDK_CONFIG=/absolute/path/to/aixand-ir/examples/real-agent/runtime.example.json
# WORKFLOW_PYTHON_BIN=/absolute/path/to/aixand-ir/.venv/bin

# DAG canvas runs use the durable sibling Runner service, started with SDK support.
# Defaults to RUNNER_HOME, then $XDG_STATE_HOME/runner or ~/.local/state/runner.
# WORKFLOW_RUNNER_HOME=/absolute/path/to/runner-home
# Native chat workflows share this socket with Runner --suite-socket.
# SUITE_WORKFLOW_SOCKET=/absolute/path/to/private/chat-state/native-workflows.sock

# Agents: imports the local SDK checkouts through a private Python worker.
# Uses aixand-ir/.venv/bin/python when present, otherwise python3.
# AGENTS_PYTHON=/absolute/path/to/python
# AGENTS_BRIDGE_PATH=/absolute/path/to/aixand-server/agent-bridge/main.py
# AGENTS_MANAGER_SOURCE=/absolute/path/to/agent-manager
# AGENTS_RUNTIME_SOURCE=/absolute/path/to/undercurrent/python/src
# AGENTS_CWD=/absolute/path/to/default-project-directory
# Codex chat metadata and retry journal; defaults to ~/.local/state/aixand/chats.
# AGENTS_STATE_DIR=/absolute/path/to/private/chat-state
# Per-conversation Codex workspaces; defaults to ~/.aixand/aixand-suite/codex.
# AGENTS_SCRATCH_DIR=/absolute/path/to/chat-workspaces
# Workspace tools in new Codex chats: saved-project discovery and standalone read-only audits.
# Enabled by default; set to 0 to disable new launches while keeping ordinary chat available.
# AGENTS_WORKSPACE_TOOLS=1
# Shared with the CLI/workflow integration; unset values use SDK defaults.
# AGENT_MANAGER_HOME=/absolute/path/to/agent-manager-home
# AGENT_MANAGER_CONFIG=/absolute/path/to/providers.toml
# UNDERCURRENT_PYTHON_BRIDGE=/absolute/path/to/uc-python-bridge

# Vox: global Pipecat voice assistant using managed Codex profiles.
# Prepare with: cd ../aixand-vox && uv sync --locked --python 3.12 && uv run aixand-vox-prepare
# VOX_PYTHON=/absolute/path/to/aixand-vox/.venv/bin/python
# VOX_STATE_DIR=/absolute/path/to/private/vox-state
# VOX_MODEL=profile-default-model
# VOX_WHISPER_MODEL=base
# VOX_WHISPER_DEVICE=cpu
# VOX_WHISPER_COMPUTE=int8
# VOX_TTS_VOICE=af_heart
# VOX_SPEECH_PAUSE_SECONDS=1.0
# VOX_WAKE_MODEL_DIR=/absolute/path/to/keyword-model-cache
# VOX_ICE_SERVERS=stun:stun.example.com:3478
# HF_HOME=/absolute/path/to/model-cache
# HF_HUB_OFFLINE=1

# Prompts: share the CLI's store; unset preserves Prompt Manager's default home.
# PROMPT_MANAGER_HOME=/absolute/path/to/prompt-manager-home
# PROMPTS_MANAGER_SOURCE=/absolute/path/to/prompt-manager/src
# Authoring roots separated by the OS path separator. Unset discovers sibling packs.
# Set an empty value to skip automatic source registration.
# PROMPTS_PACK_PATHS=/absolute/path/to/packs

# Carrier: the persistent local service is started independently with carrier serve.
# The default user mailbox is suite/local/user; credentials are reused across restarts.
# CARRIER_URL=http://127.0.0.1:8765
# Required for provisioning: the exact --db path used by the running Carrier service.
# Installed Carrier services may use ~/.local/share/carrier/carrier.db.
# CARRIER_DATABASE=/absolute/path/to/carrier.db
# CARRIER_PYTHON=/absolute/path/to/python/environment/bin/python
# Agent bridge defaults to the sibling Carrier source checkout.
# CARRIER_SOURCE=/absolute/path/to/carrier
# CARRIER_STATE_DIR=/absolute/path/to/private/suite/carrier
# CARRIER_STATE_DATABASE=/absolute/path/to/private/suite/carrier/suite.db
# CARRIER_WORKSPACE_ID=local
# CARRIER_USER_ADDRESS=suite/local/user
# CARRIER_USER_CREDENTIALS=/absolute/path/to/private/user.json
# CARRIER_AUTO_PROVISION=1
# CARRIER_POLL_INTERVAL=2
# Set a fresh instance ID if the Carrier dataset is replaced/reset.
# CARRIER_INSTANCE_ID=local-carrier-dataset-1
# Additional application mailbox credentials; server-only JSON array.
# CARRIER_MAILBOXES_FILE=/absolute/path/to/mailboxes.json
# Optional custom runtime/provider/context/budget configuration; Codex defaults work without it.
# CARRIER_AGENT_CONFIG=/absolute/path/to/carrier-agent-config.json

# Optional source root containing the aixand_connect Python package.
# Defaults to the sibling aixand-connect directory. Credentials are entered in
# Settings > Devices, not environment variables or chat.
# AIXAND_CONNECT_SOURCE=/absolute/path/to/aixand-connect
# Manager Suites resources and retained backend sessions.
# Install the local wheels into AGENTS_PYTHON with agent-manager[prompts,skills,backends].
# SKILL_MANAGER_HOME=/absolute/skill-store
# SKILLS_SOURCE_PATHS=/absolute/writable/skill-collection
# Optional additional providers must be configured in AGENT_MANAGER_CONFIG.
# SUITE_CHAT_PROVIDERS=claude,antigravity
# SKILLS_MANAGER_SOURCE=/absolute/manager-suites/skill-manager/src
# MCPS_MANAGER_SOURCE=/absolute/manager-suites/mcp-manager/src
# SERVERS_MANAGER_SOURCE=/absolute/manager-suites/server-manager/src
# RESOURCE_SOURCES_SOURCE=/absolute/manager-suites/resource-sources/src
