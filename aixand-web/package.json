{
  "name": "aixand-web",
  "version": "0.1.0-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "tauri dev",
    "desktop:dev:ssh": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:export": "python3 scripts/export-desktop.py",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "lint": "oxlint src tests",
    "test": "playwright test",
    "test:workflow-builder": "playwright test --config playwright.builder.config.ts",
    "test:workflows:contract": "node scripts/check-workflow-runner-contract.mjs",
    "test:workflows:sequence": "npm --prefix ../aixand-server run build && node scripts/test-workflow-sequence-live.mjs",
    "test:workflows:brain": "npm --prefix ../aixand-server run build && node scripts/test-workflow-brain-live.mjs",
    "test:agents": "npm --prefix ../aixand-server run bridge:build && node scripts/test-agents-live.mjs",
    "test:agents:ui": "playwright test --config playwright.agents.config.ts",
    "test:chats": "node scripts/test-chats-live.mjs",
    "test:chat-terminals": "node scripts/test-chats-live.mjs --shared-terminals",
    "test:recovery": "playwright test --config playwright.recovery.config.ts",
    "test:chat-delegations": "node scripts/test-chat-delegations-live.mjs",
    "test:command": "node scripts/test-command-live.mjs",
    "test:command:ui": "playwright test --config playwright.command.config.ts",
    "test:voice": "playwright test --config playwright.voice.config.ts",
    "test:vox": "node scripts/test-vox-live.mjs",
    "test:vox:wake": "node scripts/test-vox-wake-live.mjs",
    "test:vox:interrupt": "node scripts/test-vox-interrupt-live.mjs",
    "test:settings": "playwright test --config playwright.settings.config.ts",
    "test:soft-content": "playwright test --config playwright.soft-content.config.ts",
    "test:mcp": "playwright test --config playwright.mcp.config.ts",
    "test:workflows:live": "npm --prefix ../aixand-server run build && npm --prefix ../aixand-server run workflow:build && node scripts/test-workflows-live.mjs",
    "test:terminals": "npm --prefix ../aixand-server run build && npm --prefix ../aixand-server run bridge:build && node scripts/test-terminals-live.mjs",
    "test:carrier": "node scripts/test-carrier-live.mjs",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:onboarding": "playwright test --config playwright.onboarding.config.ts",
    "test:prompts": "playwright test --config playwright.prompts.config.ts",
    "test:managed": "playwright test --config playwright.managed.config.ts",
    "connect:bundle": "python3 ../aixand-connect/build_companion.py public/downloads/aixand-connect.pyz",
    "predev": "npm run connect:bundle",
    "prebuild": "npm run connect:bundle",
    "test:connect": "playwright test --config playwright.connect.config.ts",
    "test:resource-sources": "playwright test --config playwright.sources.config.ts",
    "test:mcp-managed": "playwright test --config playwright.mcp-managed.config.ts",
    "test:onboarding:live": "node scripts/test-onboarding-live.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "bbb-design": "file:vendor/bbb-design-0.2.0.tgz",
    "codemirror": "^6.0.2",
    "mermaid": "^12.2.0",
    "react": "^19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
