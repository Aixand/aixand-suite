# Optional overrides for npm run start:prod / node scripts/production.mjs serve.
# Existing Suite runtime paths and credentials continue to come from .env.
AIXAND_PRODUCTION_HOST=127.0.0.1
AIXAND_PRODUCTION_PORT=8753
AIXAND_PRODUCTION_ORIGINS=http://127.0.0.1:8753,http://localhost:8753
AIXAND_PRODUCTION_TRANSPORT=loopback
# AIXAND_PRODUCTION_WEB_DIST=/absolute/path/to/apps/web/dist
# HTTPS reverse proxy deployment:
# AIXAND_PRODUCTION_TRANSPORT=https-proxy
# AIXAND_PRODUCTION_ORIGINS=https://aixand.example.com
# AIXAND_PRODUCTION_TRUST_PROXY=127.0.0.1
